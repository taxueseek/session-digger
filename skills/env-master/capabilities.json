{
  "version": "1.0.0",
  "description": "env-master 能力注册表：每个环境的原生诊断命令 + 盲区映射。扩展 env-doctor 的 capabilities.json，增加 deepseek/cursor/aider。",
  "updated": "2026-07-28",
  "environments": {
    "claude": {
      "label": "Claude Code",
      "config_dir": "~/.claude",
      "native_commands": [
        {
          "name": "/doctor",
          "type": "slash_command",
          "scope": ["install", "config", "hooks", "PATH", "settings", "skills", "MCP"],
          "output": "text",
          "notes": "会话内斜杠命令。检查重复安装、PATH 问题、settings 解析、未使用的 skills/MCP/servers、慢 hooks、CLAUDE.md 冗余。"
        },
        {
          "name": "/context",
          "type": "slash_command",
          "scope": ["token_usage", "context_window"],
          "output": "visual_grid"
        },
        {
          "name": "/hooks",
          "type": "slash_command",
          "scope": ["hook_registry", "hook_sources"],
          "output": "list"
        },
        {
          "name": "/mcp",
          "type": "slash_command",
          "scope": ["mcp_servers", "oauth_status"],
          "output": "list"
        }
      ],
      "blind_spots": ["cross_env_drift", "api_reachability", "path_conflict", "env_var_redundancy"]
    },
    "codex": {
      "label": "Codex",
      "config_dir": "~/.codex",
      "native_commands": [
        {
          "name": "codex doctor --json",
          "type": "cli_flag",
          "scope": ["install", "config", "auth", "network", "mcp", "app_server", "git", "updates"],
          "output": "structured_json",
          "notes": "18 项结构化检查。每项有 status(ok/warn/fail) + summary + details + remediation。"
        },
        {
          "name": "codex debug models",
          "type": "cli_subcommand",
          "scope": ["model_catalog", "provider_config"],
          "output": "json"
        }
      ],
      "blind_spots": ["cross_env_drift", "path_conflict", "skill_version_diff"]
    },
    "grok": {
      "label": "Grok Build",
      "config_dir": "~/.grok",
      "native_commands": [
        {
          "name": "grok inspect --json",
          "type": "cli_flag",
          "scope": ["version", "skills", "hooks", "agents", "plugins", "mcp_servers", "lsp_servers", "config_sources"],
          "output": "structured_json"
        }
      ],
      "blind_spots": ["cross_env_drift", "api_reachability", "path_conflict", "network"]
    },
    "kimi": {
      "label": "Kimi Code",
      "config_dir": "~/.kimi-code",
      "native_commands": [
        {
          "name": "kimi doctor config",
          "type": "cli_subcommand",
          "scope": ["config_validation"],
          "output": "text"
        },
        {
          "name": "kimi doctor tui",
          "type": "cli_subcommand",
          "scope": ["tui_config_validation"],
          "output": "text"
        }
      ],
      "blind_spots": ["cross_env_drift", "api_reachability", "path_conflict", "network", "install", "skills", "hooks"]
    },
    "mimo": {
      "label": "MiMo Code",
      "config_dir": "~/.mimocode",
      "native_commands": [
        {
          "name": "mimo debug config",
          "type": "cli_subcommand",
          "scope": ["config_structure"],
          "output": "text"
        },
        {
          "name": "mimo debug paths",
          "type": "cli_subcommand",
          "scope": ["paths"],
          "output": "text"
        }
      ],
      "blind_spots": ["cross_env_drift", "api_reachability", "path_conflict", "network", "auth"]
    },
    "deepseek": {
      "label": "DeepSeek",
      "config_dir": "~/.deepseek",
      "native_commands": [
        {
          "name": "deepseek --check",
          "type": "cli_flag",
          "scope": ["install", "config", "auth"],
          "output": "text",
          "notes": "推断实现。部分版本可能不支持 --check。"
        },
        {
          "name": "deepseek --version",
          "type": "cli_flag",
          "scope": ["version"],
          "output": "text"
        }
      ],
      "blind_spots": ["cross_env_drift", "api_reachability", "path_conflict", "network", "auth", "extensions"],
      "implementation": "inferred"
    },
    "cursor": {
      "label": "Cursor",
      "config_dir": "~/.cursor",
      "native_commands": [
        {
          "name": "cursor --version",
          "type": "cli_flag",
          "scope": ["version"],
          "output": "text"
        }
      ],
      "blind_spots": ["cross_env_drift", "api_reachability", "path_conflict", "network", "auth", "extensions"],
      "implementation": "inferred",
      "notes": "Cursor 主要是一个 IDE，CLI 能力有限。配置目录检查为主。"
    },
    "aider": {
      "label": "Aider",
      "config_dir": "~/.aider.conf.yml",
      "native_commands": [
        {
          "name": "aider --version",
          "type": "cli_flag",
          "scope": ["version"],
          "output": "text"
        }
      ],
      "blind_spots": ["cross_env_drift", "api_reachability", "path_conflict", "network", "extensions"],
      "implementation": "inferred"
    }
  },
  "script_layer": {
    "description": "只做原生命令的盲区。薄、单一职责、JSON 输出。",
    "scripts": [
      {
        "name": "check_network",
        "scope": ["api_reachability", "proxy_health", "latency"],
        "target_envs": ["cross"],
        "output": "json",
        "why_native_cannot": "每个环境的 API URL 不同，原生只看自己的链路。"
      },
      {
        "name": "check_path_conflicts",
        "scope": ["path_conflict", "path_priority"],
        "target_envs": ["cross"],
        "output": "json",
        "why_native_cannot": "PATH 冲突是操作系统级概念，单环境不感知重复。"
      },
      {
        "name": "check_skill_drift",
        "scope": ["skill_version_diff", "install_drift"],
        "target_envs": ["cross"],
        "output": "json",
        "why_native_cannot": "Skill 漂移是跨目录概念。"
      },
      {
        "name": "check_known_patterns",
        "scope": ["known_patterns", "historical_issues"],
        "target_envs": ["cross"],
        "output": "json",
        "why_native_cannot": "需要历史会话索引数据，原生命令无法访问。"
      }
    ]
  },
  "scoring": {
    "method": "deduction",
    "rules": {
      "critical": -25,
      "warning": -10,
      "info": -5,
      "ok": 0,
      "floor": 0,
      "ceiling": 100
    },
    "dimensions": {
      "install": 0.15,
      "config": 0.25,
      "auth": 0.20,
      "network": 0.15,
      "extensions": 0.15,
      "cross_env": 0.10
    }
  },
  "unknown_env_fallback": {
    "description": "遇到未注册环境时的降级探测策略",
    "generic_checks": [
      "which <cmd> — 是否在 PATH",
      "<cmd> --version — 版本号",
      "<cmd> --help 2>&1 | grep -iE 'doctor|check|status|config|debug' — 发现诊断入口",
      "ls -la ~/.<name>/ — 配置目录结构",
      "cat ~/.<name>/config.toml 或 settings.json — 配置健康度",
      "ls ~/.<name>/skills/ — skill 安装数量",
      "ls ~/.<name>/hooks/ — hook 注册情况"
    ]
  }
}
